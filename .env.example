# 复制本文件为 .env 后按需修改（.env 含密钥，绝不提交 Git）

# 服务端口
PORT=3000

# ---- 飞书应用凭证（开发者后台 > 凭证与基础信息）----
# 严禁写入 public/、严禁返回前端、严禁硬编码
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# OAuth 回调地址：必须与飞书后台「安全设置 > 重定向 URL」中配置的完全一致
FEISHU_REDIRECT_URI=https://ai.wzyiloveu.kdns.fr/auth/feishu/callback

# 站点对外地址（用于拼接默认回调地址与后续飞书内嵌跳转）
BASE_URL=https://ai.wzyiloveu.kdns.fr

# Session 签名密钥：任意足够长的随机字符串，例如 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 可选：仅在「非 localhost 的纯 HTTP」环境调试时设为 false 关闭 Secure Cookie
# 走 Cloudflare Tunnel（HTTPS）或 localhost 时保持默认即可
# COOKIE_SECURE=false

# ==================== AI Provider ====================
# 支持任意 OpenAI-Compatible 中转站；代码里不写死任何中转站地址。
#
# 使用中转站时：
#   AI_BASE_URL 填中转站给出的 OpenAI-Compatible Base URL，
#   一般形式例如 https://example.com/v1 （代码不会再额外拼接 /v1）。
#   留空则默认连接 OpenAI 官方 https://api.openai.com/v1 。
AI_BASE_URL=

# 中转站（或官方）提供的 API Key：绝不提交 Git、绝不返回前端
AI_API_KEY=

# 模型名称（由中转站 / 官方决定，例如 your-model-name）
AI_MODEL=

# 接口模式：
#   responses        中转站支持 POST /v1/responses 时使用
#   chat_completions 中转站只支持 POST /v1/chat/completions 时使用
# 失败时不会自动切换模式重发收费请求；若 responses 返回 404，
# 页面会提示「请将 AI_API_MODE 改为 chat_completions」。
AI_API_MODE=responses

# ---- AI 生图（浏览器自动化模式，唯一实现；API 生图模式已移除）----
# 原理：驱动本机「已登录 ChatGPT」的调试 Chrome 生图，不调任何 API
# 前置：先运行 work/start-debug-chrome.ps1 启动调试 Chrome 并人工登录（详见 README §14.8）
#   ⚠ 以自动化方式使用 ChatGPT 网页版违反 OpenAI 服务条款，有封号风险，仅建议小号
#
# 停用生图：AI_IMAGE_MODEL=off（或 none/false/disabled/0）
# AI_IMAGE_MODEL=off
#
# 以下均可选，默认值已够用：
# AI_IMAGE_BROWSER_CDP=http://127.0.0.1:9222
# AI_IMAGE_BROWSER_TIMEOUT_MS=180000     # 单次生成总超时
# AI_IMAGE_BROWSER_CONCURRENCY=1         # 并发上限（默认 1，最大 3）

# 可选：上传大小兜底（单位 MB）。**默认不设置 = 不限制文件大小**
# UPLOAD_MAX_MB=100

# 可选：图片附件以 base64 内联发给模型（多模态视觉）。模型不支持视觉时设 false
# AI_VISION=true

# ---- 联网搜索 ----
# 总开关：false 关闭（默认开启）。前端输入框「联网」按钮控制每次提问是否检索
WEB_SEARCH_ENABLED=true

# 搜索提供商：duckduckgo（默认，免 Key）| searxng | brave | tavily | bing
WEB_SEARCH_PROVIDER=duckduckgo

# 失败转移链（2026-09-20 起内置，无需配置）：主提供商请求失败/空结果时，
# 自动依次尝试其余「已配置 Key」的提供商，duckduckgo 永远垫底兜底；
# 缺 Key 等配置错误不触发转移。

# searxng（免 Key 元搜索）：逗号分隔可配多个实例做实例级转移；不配则用公共默认实例。
# 公共实例 JSON 接口不稳（实测 403/418/429 常见），追求稳定请用 searxng/searxng-docker 自建
# SEARXNG_BASE_URL=https://你的实例,https://备用实例

# 选用 brave / tavily / bing 时填写对应 Key（duckduckgo / searxng 不需要）
# BRAVE_SEARCH_KEY=      # https://brave.com/search/api 免费 2000 次/月
# TAVILY_API_KEY=        # https://tavily.com 免费 1000 次/月
# BING_SEARCH_KEY=

# ---- 旧变量兼容（上面的 AI_* 优先；可留空）----
OPENAI_API_KEY=
OPENAI_MODEL=

# 可选：上游空闲超时（毫秒）。超过这么久没有任何事件就放弃本次请求，默认 60000
# OPENAI_IDLE_TIMEOUT_MS=60000

# ---- 浏览器自动化 Provider（复用本机已登录的 ChatGPT Plus）----
# 对话 Provider：api（默认，走 AI_* 接口）| browser（走本机 ChatGPT Plus 网页）
# AI_CHAT_PROVIDER=api
# ChatGPT「项目」页 URL：新对话与新图片都会归档进这个项目；留空则开普通新会话
# AI_BROWSER_PROJECT_URL=
# 调试 Chrome 的 CDP 地址与超时（默认值，按需调整）
# AI_IMAGE_BROWSER_CDP=http://127.0.0.1:9222
# AI_CHAT_BROWSER_TIMEOUT_MS=240000
